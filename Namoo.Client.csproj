<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Namoo.Client</RootNamespace>
    <AssemblyName>Namoo.Client</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\namoo.controls\Namoo.Controls.csproj" />
    <ProjectReference Include="..\namoo.controls.devexp\Namoo.Controls.DevExp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\110912-font-awesome\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\magnifying-glass.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\row_add.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\row_remove.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\110912-font-awesome\license\license.pdf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Namoo.Client.Forms" />
  </ItemGroup>
</Project>
